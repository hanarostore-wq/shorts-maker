{
  "manifest_version": 3,
  "name": "머니OS 상품소싱 · Manus",
  "version": "1.0.0",
  "description": "현재 쇼핑몰 화면의 상품만 머니OS 소싱관리로 전송합니다.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://shorts-maker-omega.vercel.app/*"],
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "머니OS 상품소싱",
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  }
}
