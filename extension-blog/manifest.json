{
  "manifest_version": 3,
  "name": "머니OS 블로그 발행센터",
  "version": "0.1.0",
  "description": "GPT의 MONEYOS 블록을 읽어 네이버 블로그 발행을 준비하고 실행합니다.",
  "permissions": ["storage", "tabs", "activeTab", "scripting", "notifications", "alarms"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://blog.naver.com/*",
    "https://m.blog.naver.com/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "action": { "default_title": "머니OS 블로그 발행센터", "default_popup": "popup.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    { "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["content/gpt-reader.js"], "run_at": "document_idle" },
    { "matches": ["https://blog.naver.com/*", "https://m.blog.naver.com/*"], "js": ["content/naver-editor.js"], "run_at": "document_idle" }
  ],
  "commands": {
    "read-current-gpt": { "suggested_key": { "default": "Ctrl+Shift+M" }, "description": "현재 GPT 화면의 MONEYOS 글 읽기" }
  },
  "icons": { "16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png" }
}
