{
  "manifest_version": 3,
  "name": "소싱 마스터 PRO - 상품 소싱 + 마진 계산",
  "version": "3.0.0",
  "description": "쇼핑몰 화면에서 상품 정보를 바로 수집하고, 수수료·택배비까지 계산해 팔면 얼마 남는지 즉시 알려줍니다.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://shorts-maker-omega.vercel.app/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "소싱 마스터"
  }
}
