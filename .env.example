# 스마트스토어(네이버 커머스API) - https://apicenter.commerce.naver.com 에서 애플리케이션 등록 후 발급
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 쿠팡(오픈API) - 쿠팡윙 판매자 센터 > 오픈API 관리에서 발급
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
COUPANG_VENDOR_ID=

# 업비트 키 암호화 저장용. 긴 무작위 문자열을 Vercel 환경변수에 등록
COIN_CREDENTIALS_ENCRYPTION_KEY=

# 나무플러그 키 저장용. 없으면 COIN_CREDENTIALS_ENCRYPTION_KEY를 공통 암호화 시드로 사용
STOCK_CREDENTIALS_ENCRYPTION_KEY=

# Google AdSense OAuth - Google Cloud Console OAuth Web Client 설정값
GOOGLE_ADSENSE_CLIENT_ID=
GOOGLE_ADSENSE_CLIENT_SECRET=
# Production: https://shorts-maker-omega.vercel.app/api/blog/adsense/oauth/callback
GOOGLE_ADSENSE_REDIRECT_URI=

# AdSense access/refresh token 암호화 저장용. 긴 무작위 문자열을 Vercel 환경변수에 등록
ADSENSE_CREDENTIALS_ENCRYPTION_KEY=
