COUPANG_SECRET_KEY=
COUPANG_VENDOR_ID=

# (선택) API 주소 재정의 — 자격증명 없이 동작을 시험할 때 모의 서버를
# 가리키게 하는 용도. 비워두면 실제 주소를 쓴다.
