# 스마트스토어(네이버 커머스API) - https://apicenter.commerce.naver.com 에서 애플리케이션 등록 후 발급
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 쿠팡(오픈API) - 쿠팡윙 판매자 센터 > 오픈API 관리에서 발급
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
COUPANG_VENDOR_ID=

# ── 유료 확장앱(라이선스) ─────────────────────────────────────────────
# 라이선스 키 서명용 비밀키. 아무 긴 랜덤 문자열 (한 번 정하면 바꾸지 말 것:
# 바꾸면 이미 판매된 키가 전부 무효가 된다)
LICENSE_SIGNING_SECRET=
# 키 발급/조회/회수 API를 부를 때 쓰는 관리자 토큰
LICENSE_ADMIN_TOKEN=
# 결제 웹훅 서명 검증용 비밀키 (결제 업체 대시보드에도 같은 값을 넣는다)
LICENSE_WEBHOOK_SECRET=
# true로 두면 무료 한도/프로 기능 제한이 실제로 적용된다.
# 비워두면 예전처럼 제한 없이 동작한다 (혼자 쓸 때)
LICENSE_ENFORCED=
# 판매 페이지(/pro)의 구매 버튼이 연결될 결제 링크
CHECKOUT_URL_PRO=
CHECKOUT_URL_LIFETIME=
# 판매 페이지에 노출할 문의처 (카톡 ID, 이메일 등)
SUPPORT_CONTACT=
