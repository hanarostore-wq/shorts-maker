{
  "name": "unyoung-browser",
  "version": "0.1.0",
  "private": true,
  "description": "운영본부 관제실이 내장된 업무용 브라우저",
  "author": "운영본부",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:local": "CONTROL_URL=http://localhost:3000 electron .",
    "dist:win": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0"
  },
  "build": {
    "appId": "kr.unyoung.browser",
    "productName": "unyoung-browser",
    "files": [
      "main.js",
      "preload.js",
      "settings.js",
      "agent/**/*",
      "renderer/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "운영본부 브라우저",
      "artifactName": "unyoung-browser-setup-${version}.${ext}"
    }
  }
}
